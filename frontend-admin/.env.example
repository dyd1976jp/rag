# 前端管理后台配置文件示例
# 复制此文件为 .env 并根据您的环境修改配置

# ==================== 开发服务器配置 ====================
VITE_DEV_PORT=5174

# ==================== API配置 ====================
VITE_API_BASE_URL=http://localhost:8000
VITE_API_VERSION=/api/v1

# ==================== 认证配置 ====================
VITE_TOKEN_STORAGE_KEY=rag_chat_admin_token
VITE_USER_STORAGE_KEY=rag_chat_admin_user

# ==================== UI配置 ====================
VITE_APP_NAME=RAG Chat Admin
VITE_DEFAULT_THEME=light
VITE_DEFAULT_LOCALE=zh-CN

# ==================== 管理功能配置 ====================
VITE_ENABLE_SYSTEM_MONITOR=true
VITE_ENABLE_USER_MANAGEMENT=true
VITE_ENABLE_VECTOR_MANAGEMENT=true

# ==================== 环境特定配置 ====================
# 开发环境
VITE_ENABLE_DEBUG=true
VITE_ENABLE_MOCK=false

# 生产环境（在生产环境中设置）
# VITE_ENABLE_DEBUG=false
# VITE_ENABLE_MOCK=false
# VITE_API_BASE_URL=https://your-production-api.com
